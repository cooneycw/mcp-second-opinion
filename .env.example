# MCP Second Opinion Server Environment Variables (EXAMPLE)
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#   nano .env  # edit with your API keys
#
# You need at least ONE API key (Gemini or OpenAI) for the server to work.
# For multi-model comparison, configure both.

# =============================================================================
# Gemini API (Google)
# =============================================================================
# Get your Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Available models:
#   - gemini-3.6-flash: Fast default ($1.50/$7.50 per 1M tokens)
#   - gemini-3.1-pro-preview: Stable fallback ($2/$12 per 1M tokens)

# =============================================================================
# OpenAI API (GPT-5.4, Codex, o3/o4 reasoning models)
# =============================================================================
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Available models:
#   - gpt-5.4: Default model, stable billing ($2.50/$15 per 1M tokens, Responses API)
#   - gpt-5.4-mini: Cost-effective fan-out ($0.75/$4.50 per 1M tokens)
#   - gpt-5.3-codex: Default Codex model for coding (Responses API)
#   - gpt-5.2-codex: Cost-effective coding (Responses API)
#   - gpt-5.2, gpt-5.2-mini: Previous-gen GPT models
#   - o4-mini: Fast reasoning (Responses API, successor to o3-mini)
#   - o3: Advanced reasoning (Responses API)
#   - gpt-4o, gpt-4o-mini: Fast multimodal models
# Note: gpt-5.5 retired from defaults (legacy, $5/$30) - issue #3

# =============================================================================
# Anthropic API (Claude Sonnet, Haiku, Opus)
# =============================================================================
# Get your Anthropic API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Available models:
#   - claude-sonnet-5: Near-Opus code review quality ($3/$15 per 1M tokens; intro $2/$10 to 2026-08-31)
#   - claude-haiku-4-5-20251001: Fastest, cost-effective ($1/$5 per 1M tokens)
#   - claude-opus-5: Most capable, complex reasoning ($5/$25 per 1M tokens)

# =============================================================================
# Server configuration
# =============================================================================
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080

# Context caching (reduces cost by 90% for repeated prompts - Gemini only)
ENABLE_CONTEXT_CACHING=true
CACHE_TTL_MINUTES=60
